spring.application.name=SupportAI

spring.datasource.url=jdbc:mysql://localhost:3306/tms
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# Use a random secret of at least 32 UTF-8 bytes. Never commit the real value.
app.jwt.secret=${APP_JWT_SECRET}
app.jwt.expiration-minutes=60

# Google Cloud Console OAuth 2.0 Web application credentials
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}
spring.security.oauth2.client.registration.google.scope=openid,profile,email
